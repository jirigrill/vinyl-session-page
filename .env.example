# Copy to .env (git-ignored). Never commit real values.

# YouTube Data API key. IP-restricted to the droplet; used by `make ingest-remote`.
YT_DATA_API_KEY=

# Basic auth for the web UI. `make run` defaults both to "dev".
VINYL_USER=dev
VINYL_PASSWORD=dev

# Directory holding vinyl.db. `make run` overrides this with data/local.
VINYL_DATA_DIR=.

# Channel list for `vinyl ingest`.
VINYL_SEED_FILE=data/seed-channels.txt

# Listen address for the server.
VINYL_ADDR=127.0.0.1:8080
